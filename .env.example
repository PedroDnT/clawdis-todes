# Clawdis Environment Variables Example
# Copy to .env and fill in your values

# ============================================================================
# Gateway Configuration
# ============================================================================
CLAWDIS_GATEWAY_TOKEN=                    # Optional: Authentication token for gateway (generate with: openssl rand -hex 32)
CLAWDIS_GATEWAY_PORT=18789                # Optional: Override default gateway port
CLAWDIS_GATEWAY_HOST=127.0.0.1            # Optional: Override default bind host

# ============================================================================
# Provider Tokens
# ============================================================================
# Telegram (optional, can also be set in config file)
TELEGRAM_BOT_TOKEN=                       # Get from @BotFather on Telegram

# Discord (optional, can also be set in config file)
DISCORD_BOT_TOKEN=                        # Get from Discord Developer Portal

# Twilio (legacy/optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# ============================================================================
# Canvas Host
# ============================================================================
CLAWDIS_SKIP_CANVAS_HOST=                 # Set to '1' to disable canvas host server

# ============================================================================
# Agent Configuration
# ============================================================================
PI_BASH_YIELD_MS=20000                    # Background bash yield timeout (milliseconds)
PI_BASH_MAX_OUTPUT_CHARS=524288           # Max bash output to keep in memory
PI_BASH_JOB_TTL_MS=1800000                # TTL for finished bash sessions (milliseconds)

# ============================================================================
# Development
# ============================================================================
NODE_ENV=development                      # Environment: development, production
LOG_LEVEL=debug                           # Log level: error, warn, info, debug, trace

# ============================================================================
# Paths (optional overrides)
# ============================================================================
# CLAWDIS_HOME=$HOME/.clawdis             # Override config/credentials directory
# CLAWDIS_WORKSPACE=$HOME/clawd           # Override agent workspace directory
